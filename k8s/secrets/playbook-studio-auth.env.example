# k8s-target: namespace=playbook-studio, name=playbook-studio-auth, type=Opaque
# The app's HTTP Basic credential for its /mcp machine door (fails closed until this
# Secret exists). Copy to k8s/secrets/playbook-studio-auth.env (git-ignored), fill the values, and
# apply with the platform's seed/apply-secrets.sh. Never commit the real file.
STUDIO_AUTH_USER=
STUDIO_AUTH_PASSWORD=
