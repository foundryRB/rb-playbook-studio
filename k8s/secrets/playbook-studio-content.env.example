# k8s-target: namespace=playbook-studio, name=playbook-studio-content, type=Opaque
# The content repo the studio manages: an https clone URL with an embedded fine-grained
# PAT (contents read/write on the content repo only). Copy to
# k8s/secrets/playbook-studio-content.env (git-ignored), fill the value, and apply with
# the platform's seed/apply-secrets.sh. Never commit the real file.
STUDIO_CONTENT_REPO_URL=
